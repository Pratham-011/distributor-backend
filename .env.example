# ---- Database ----
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (works on IPv4)
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Leave unset to use the built-in local database (no setup, good for trying it out):
DATABASE_URL=pglite:./data/db

# ---- File storage (original uploads, gzip-compressed) ----
# Supabase: Project Settings -> API. Use the service_role key here ONLY (never in the web app).
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=uploads
# Without the two lines above, files are kept in ./data/files

# ---- Login ----
# Long random text. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
# true = the OTP is shown on screen and in the server log (demo). false = hook up an email sender in src/auth.js
OTP_DEMO=true

# ---- Platform admin (you, the software owner) ----
# Emails (comma-separated) that see the "Platform admin" page: every business, space, use, subscription, pause / renew.
# These must be emails of accounts that log in to this app.
PLATFORM_ADMIN_EMAILS=you@yourbrand.in
# Shown to a business whose portal is paused or whose subscription ended
SUPPORT_CONTACT=98200 00000 / support@yourbrand.in

# ---- Uploads ----
# Largest file accepted, in MB (25 on a 512 MB server; 50 is fine on 2 GB)
MAX_FILE_MB=25
# How many Excel files the server reads at the same time (1 keeps memory lowest)
PARSE_CONCURRENCY=1

# ---- Other ----
PORT=4000
# State code of the distributor's GSTIN (27 = Maharashtra), used for the IGST check
HOME_STATE_CODE=27
# Only needed if the web app is hosted on a different domain from the server
# CORS_ORIGIN=https://reports.example.com
